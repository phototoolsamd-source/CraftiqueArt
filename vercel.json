{
  "name": "craftique",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/p/(.*)",
      "destination": "/api/index.js?sku=$1"
    },
    {
      "source": "/product/(.*)",
      "destination": "/api/index.js?sku=$1"
    },
    {
      "source": "/share/(.*)",
      "destination": "/api/index.js?sku=$1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "product"
        }
      ],
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "p"
        }
      ],
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
